{
  "name": "thisishugo.com",
  "version": "3.0.0",
  "description": "Hugo Jobling's Website",
  "keywords": [
    "hugo",
    "hugo jobling",
    "jobling",
    "thisishugo.com"
  ],
  "homepage": "https://github.com/hugo/thisishugo.com",
  "bugs": {
    "url": "https://github.com/hugo/thisishugo.com/issues"
  },
  "license": "MIT",
  "author": "Hugo Jobling <hello@thisishugo.com> (https://thisishugo.com)",
  "repository": {
    "type": "git",
    "url": "git@github.com:hugo/thisishugo.com.git"
  },
  "type": "module",
  "scripts": {
    "dev": "node --watch-path=src/server --watch-preserve-output src/server/main.dev.ts",
    "build": "vite build",
    "start": "node src/server/main.prod.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "oxlint --report-unused-disable-directives",
    "check:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "postinstall": "patch-package",
    "observatory": "node scripts/observatory.ts"
  },
  "dependencies": {
    "@effect/platform-browser": "4.0.6",
    "@effect/platform-node": "4.0.6",
    "@foldkit/ui": "0.169.0",
    "effect": "4.0.6",
    "foldkit": "0.169.0",
    "patch-package": "8.0.1"
  },
  "devDependencies": {
    "@effect/platform-node-shared": "4.0.6",
    "@effect/vitest": "4.0.6",
    "@foldkit/devtools": "0.169.0",
    "@foldkit/devtools-mcp": "0.25.0",
    "@foldkit/oxlint-plugin": "0.15.3",
    "@foldkit/vite-plugin": "0.28.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@vitest/browser-playwright": "5.0.5",
    "oxfmt": "0.74.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "playwright": "1.64.1",
    "tailwindcss": "4.3.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@effect/platform-browser": "$@effect/platform-browser",
    "@effect/platform-node": "$@effect/platform-node",
    "@effect/platform-node-shared": "$@effect/platform-node-shared",
    "effect": "$effect"
  },
  "engines": {
    "node": ">=26",
    "npm": ">=11"
  }
}
